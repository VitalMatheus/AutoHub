generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum OrganizationOperationalStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ActionTokenPurpose {
  ACTIVATE_ACCOUNT
  RESET_PASSWORD
}

enum QuoteStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ItemType {
  SERVICE
  PRODUCT
  MANUAL
}

enum WorkOrderStatus {
  OPEN
  WAITING_APPROVAL
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DirectSaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ExpenseCategory {
  PARTS_AND_SUPPLIES
  PERSONNEL
  RENT
  UTILITIES
  TAXES
  FINANCIAL_FEES
  MAINTENANCE
  MARKETING
  OTHER
}

enum ExpenseStatus {
  OPEN
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
}

enum BillingInterval {
  MONTHLY
}

enum SubscriptionStatus {
  SCHEDULED
  CURRENT
  ENDED
}

enum TrialReminderKind {
  SEVEN_DAYS_REMAINING
  THREE_DAYS_REMAINING
  ONE_DAY_REMAINING
  EXPIRED
}

enum SubscriptionChargeNature {
  FIRST_PAYMENT
  RENEWAL
  ADJUSTMENT
  EXTRAORDINARY
}

enum ChargeSettlementKind {
  RECEIPT
  REVERSAL
}

enum ChargeSettlementOrigin {
  GATEWAY
  ADMINISTRATIVE
}

enum AdministrativeSettlementMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  CHECK
  OTHER
}

enum ConsentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  PROMOTIONAL
}

model Plan {
  id         String    @id @default(uuid()) @db.Uuid
  code       String?   @unique
  name       String    @unique
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  versions PlanVersion[]
}

model PlanVersion {
  id                String            @id @default(uuid()) @db.Uuid
  planId            String            @db.Uuid
  version           Int
  status            PlanVersionStatus @default(DRAFT)
  price             Decimal           @db.Decimal(12, 2)
  currency          String            @default("BRL") @db.Char(3)
  interval          BillingInterval   @default(MONTHLY)
  organizationLimit Int
  userLimit         Int
  workOrderLimit    Int?
  gracePeriodDays   Int               @default(5)
  publishedAt       DateTime?         @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  plan                   Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions          Subscription[]
  scheduledSubscriptions Subscription[] @relation("ScheduledSubscriptionPlan")

  @@unique([planId, version])
  @@index([status, publishedAt])
}

// Minimal contract reference for protecting versions already used by a later
// commercial module. It intentionally has no lifecycle or API in this scope.
model Subscription {
  id                             String             @id @default(uuid()) @db.Uuid
  commercialAccountId            String?            @db.Uuid
  planVersionId                  String             @db.Uuid
  status                         SubscriptionStatus @default(SCHEDULED)
  contractedPrice                Decimal            @default(0) @db.Decimal(12, 2)
  contractedCurrency             String             @default("BRL") @db.Char(3)
  contractedInterval             BillingInterval    @default(MONTHLY)
  contractedOrganizationLimit    Int                @default(1)
  contractedUserLimit            Int                @default(1)
  contractedWorkOrderLimit       Int?
  contractedGracePeriodDays      Int                @default(5)
  migratedAt                     DateTime?          @db.Timestamptz(3)
  regularizedAt                  DateTime?          @db.Timestamptz(3)
  regularizationReason           String?
  commercialStartAt              DateTime?          @db.Timestamptz(3)
  firstDueDate                   DateTime?          @db.Date
  billingDay                     Int?
  trialEnabled                   Boolean            @default(true)
  trialStartsAt                  DateTime?          @db.Timestamptz(3)
  trialEndsAt                    DateTime?          @db.Timestamptz(3)
  firstPaidPeriodStartedAt       DateTime?          @db.Timestamptz(3)
  firstPaymentReceivedAt         DateTime?          @db.Timestamptz(3)
  currentPeriodStart             DateTime?          @db.Timestamptz(3)
  currentPeriodEnd               DateTime?          @db.Timestamptz(3)
  cancellationRequestedAt        DateTime?          @db.Timestamptz(3)
  effectiveCancellationAt        DateTime?          @db.Timestamptz(3)
  scheduledPlanVersionId         String?            @db.Uuid
  scheduledPlanEffectiveAt       DateTime?          @db.Timestamptz(3)
  scheduledPlanReason            String?
  scheduledRecurringAdjustment   Decimal?           @db.Decimal(12, 2)
  scheduledAdjustmentEffectiveAt DateTime?          @db.Timestamptz(3)
  scheduledAdjustmentReason      String?
  createdAt                      DateTime           @default(now()) @db.Timestamptz(3)

  commercialAccount    CommercialAccount?   @relation(fields: [commercialAccountId], references: [id], onDelete: Restrict)
  planVersion          PlanVersion          @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  scheduledPlanVersion PlanVersion?         @relation("ScheduledSubscriptionPlan", fields: [scheduledPlanVersionId], references: [id], onDelete: Restrict)
  charges              SubscriptionCharge[]
  trialReminders       TrialReminder[]

  @@unique([id, commercialAccountId])
  @@index([planVersionId, status])
  @@index([commercialAccountId, status])
  @@index([scheduledPlanVersionId, scheduledPlanEffectiveAt])
}

model CommercialAccount {
  id                           String   @id @default(uuid()) @db.Uuid
  name                         String
  billingEmail                 String?
  billingDocument              String?
  primaryContactOrganizationId String?  @db.Uuid
  primaryContactUserId         String?  @db.Uuid
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(3)

  organizations              Organization[]
  subscriptions              Subscription[]
  primaryContact             User?                @relation("CommercialAccountPrimaryContact", fields: [primaryContactOrganizationId, primaryContactUserId], references: [organizationId, id], onDelete: SetNull)
  primaryContactOrganization Organization?        @relation("CommercialAccountPrimaryContactOrganization", fields: [id, primaryContactOrganizationId], references: [commercialAccountId, id], onDelete: Restrict)
  charges                    SubscriptionCharge[]

  @@index([name])
  @@index([primaryContactUserId])
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String?    @db.Uuid
  name           String
  email          String     @unique
  passwordHash   String?
  role           UserRole
  status         UserStatus @default(PENDING_ACTIVATION)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  sessions               Session[]
  organization           Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actionTokens           ActionToken[]
  auditEvents            AuditEvent[]
  primaryContactAccounts CommercialAccount[] @relation("CommercialAccountPrimaryContact")
  consentRecords         ConsentRecord[]
  trialReminders         TrialReminder[]     @relation("TrialReminderRecipient")

  @@unique([organizationId, id])
  @@index([organizationId, status])
}

// Immutable acceptance evidence. The optional relations let future signup
// flows record context without putting raw request payloads in AuditEvent.
model ConsentRecord {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String?     @db.Uuid
  organizationId String?     @db.Uuid
  type           ConsentType
  policyVersion  String      @db.VarChar(80)
  acceptedAt     DateTime    @default(now()) @db.Timestamptz(3)
  requestIp      String?     @db.VarChar(64)
  userAgent      String?
  context        String?     @db.VarChar(80)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  user         User?         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, type, acceptedAt])
  @@index([organizationId, acceptedAt])
}

// Purpose-specific pseudonymous evidence used to prevent routine repeated
// trials. It deliberately stores keyed fingerprints, never CPF/CNPJ/e-mail.
model TrialEligibilityRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  documentFingerprint String   @unique @db.VarChar(128)
  emailFingerprint    String   @unique @db.VarChar(128)
  trialStartedAt      DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
}

model TrialReminder {
  id                  String            @id @default(uuid()) @db.Uuid
  subscriptionId      String            @db.Uuid
  commercialAccountId String            @db.Uuid
  organizationId      String            @db.Uuid
  recipientUserId     String            @db.Uuid
  kind                TrialReminderKind
  scheduledAt         DateTime          @db.Timestamptz(3)
  claimedAt           DateTime?         @db.Timestamptz(3)
  sentAt              DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)

  subscription  Subscription @relation(fields: [subscriptionId, commercialAccountId], references: [id, commercialAccountId], onDelete: Restrict)
  organization  Organization @relation("TrialReminderOrganization", fields: [commercialAccountId, organizationId], references: [commercialAccountId, id], onDelete: Restrict)
  recipientUser User         @relation("TrialReminderRecipient", fields: [organizationId, recipientUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([subscriptionId, kind])
  @@index([scheduledAt, sentAt, claimedAt])
  @@index([organizationId, scheduledAt])
}

model AuditEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  actorType           AuditActorType
  actorUserId         String?        @db.Uuid
  actorName           String?
  actorEmail          String?
  occurredAt          DateTime       @default(now()) @db.Timestamptz(3)
  action              String
  targetType          String
  targetId            String
  commercialAccountId String?        @db.Uuid
  organizationId      String?        @db.Uuid
  reason              String?
  before              Json?
  after               Json?

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt, id])
  @@index([actorUserId, occurredAt, id])
  @@index([action, occurredAt, id])
  @@index([targetType, targetId, occurredAt, id])
}

model ActionToken {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  purpose   ActionTokenPurpose
  tokenHash String             @unique
  expiresAt DateTime           @db.Timestamptz(3)
  usedAt    DateTime?          @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt])
}

model Organization {
  id                   String                        @id @default(uuid()) @db.Uuid
  commercialAccountId  String?                       @unique @db.Uuid
  name                 String
  document             String?                       @unique
  phone                String?
  email                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  notes                String?
  operationalStatus    OrganizationOperationalStatus @default(ACTIVE)
  nextQuoteNumber      Int                           @default(1)
  nextWorkOrderNumber  Int                           @default(1)
  nextDirectSaleNumber Int                           @default(1)
  createdAt            DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @db.Timestamptz(3)

  users                      User[]
  customers                  Customer[]
  vehicles                   Vehicle[]
  services                   Service[]
  products                   Product[]
  suppliers                  Supplier[]
  productSuppliers           ProductSupplier[]
  quotes                     Quote[]
  quoteItems                 QuoteItem[]
  workOrders                 WorkOrder[]
  workOrderStockAllocations  WorkOrderStockAllocation[]
  workOrderItems             WorkOrderItem[]
  payments                   Payment[]
  expenses                   Expense[]
  expensePayments            ExpensePayment[]
  stockMovements             StockMovement[]
  purchases                  Purchase[]
  purchaseItems              PurchaseItem[]
  stockEntries               StockEntry[]
  directSales                DirectSale[]
  directSaleItems            DirectSaleItem[]
  directSaleStockAllocations DirectSaleStockAllocation[]
  salePayments               SalePayment[]
  commercialAccount          CommercialAccount?          @relation(fields: [commercialAccountId], references: [id], onDelete: Restrict)
  primaryContactAccounts     CommercialAccount[]         @relation("CommercialAccountPrimaryContactOrganization")
  consentRecords             ConsentRecord[]
  subscriptionCharges        SubscriptionCharge[]
  trialReminders             TrialReminder[]             @relation("TrialReminderOrganization")

  @@unique([commercialAccountId, id])
  @@index([operationalStatus])
  @@index([commercialAccountId])
}

model SubscriptionCharge {
  id                  String                   @id @default(uuid()) @db.Uuid
  commercialAccountId String                   @db.Uuid
  subscriptionId      String                   @db.Uuid
  organizationId      String?                  @db.Uuid
  amount              Decimal                  @db.Decimal(12, 2)
  dueDate             DateTime                 @db.Date
  nature              SubscriptionChargeNature
  billingPeriodStart  DateTime?                @db.Date
  billingPeriodEnd    DateTime?                @db.Date
  provider            String?
  externalId          String?
  cancelledAt         DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)

  commercialAccount CommercialAccount  @relation(fields: [commercialAccountId], references: [id], onDelete: Restrict)
  subscription      Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settlements       ChargeSettlement[]

  @@unique([provider, externalId])
  @@unique([subscriptionId, nature, billingPeriodStart, billingPeriodEnd])
  @@index([commercialAccountId, dueDate])
  @@index([subscriptionId, dueDate])
  @@index([organizationId, dueDate])
}

model ChargeSettlement {
  id                   String                          @id @default(uuid()) @db.Uuid
  chargeId             String                          @db.Uuid
  originalSettlementId String?                         @db.Uuid
  kind                 ChargeSettlementKind            @default(RECEIPT)
  origin               ChargeSettlementOrigin          @default(GATEWAY)
  method               AdministrativeSettlementMethod?
  amount               Decimal                         @db.Decimal(12, 2)
  receivedAt           DateTime                        @db.Timestamptz(3)
  effectiveAt          DateTime?                       @db.Timestamptz(3)
  reason               String?
  provider             String?
  externalId           String?
  createdAt            DateTime                        @default(now()) @db.Timestamptz(3)

  charge             SubscriptionCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  originalSettlement ChargeSettlement?  @relation("SettlementReversals", fields: [originalSettlementId], references: [id], onDelete: Restrict)
  reversals          ChargeSettlement[] @relation("SettlementReversals")

  @@unique([provider, externalId])
  @@index([chargeId, createdAt])
  @@index([originalSettlementId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  document       String?
  phone          String
  email          String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]
  quotes       Quote[]
  workOrders   WorkOrder[]
  directSales  DirectSale[]

  @@unique([organizationId, id])
  @@unique([organizationId, document])
  @@index([organizationId, active, name, id])
  @@index([organizationId, phone])
}

model Vehicle {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  customerId     String   @db.Uuid
  plate          String
  brand          String
  model          String
  year           Int?
  color          String?
  mileage        Int?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  quotes       Quote[]
  workOrders   WorkOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, plate])
  @@index([organizationId, customerId])
}

model Service {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quoteItems     QuoteItem[]
  workOrderItems WorkOrderItem[]

  @@unique([organizationId, id])
  @@index([organizationId, active, name, id])
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  sku            String
  salePrice      Decimal  @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  stockMinimum   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quoteItems      QuoteItem[]
  workOrderItems  WorkOrderItem[]
  stockMovements  StockMovement[]
  purchaseItems   PurchaseItem[]
  stockEntries    StockEntry[]
  suppliers       ProductSupplier[]
  directSaleItems DirectSaleItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId, active, name, id])
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  document       String?
  email          String?
  phone          String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     ProductSupplier[]
  purchases    Purchase[]
  stockEntries StockEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, document])
  @@index([organizationId, active, name, id])
}

model ProductSupplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  supplierId     String   @db.Uuid
  externalCode   String?
  lastCost       Decimal? @db.Decimal(12, 2)
  warrantyDays   Int      @default(0)
  preferred      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  supplier     Supplier     @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, supplierId])
  @@index([organizationId, supplierId])
  @@index([organizationId, productId, preferred])
}

model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  customerId     String      @db.Uuid
  vehicleId      String      @db.Uuid
  number         Int
  status         QuoteStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  vehicle      Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  items        QuoteItem[]
  workOrder    WorkOrder?

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
}

model QuoteItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  quoteId        String   @db.Uuid
  type           ItemType
  serviceId      String?  @db.Uuid
  productId      String?  @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(10, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quote        Quote        @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Cascade)
  service      Service?     @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)
  product      Product?     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, quoteId])
}

model WorkOrderStockAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  workOrderId     String   @db.Uuid
  workOrderItemId String   @db.Uuid
  stockEntryId    String?  @db.Uuid
  quantity        Int
  unitCost        Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder     WorkOrder     @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  workOrderItem WorkOrderItem @relation(fields: [organizationId, workOrderItemId], references: [organizationId, id], onDelete: Restrict)
  stockEntry    StockEntry?   @relation(fields: [organizationId, stockEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId])
  @@index([organizationId, workOrderItemId])
  @@index([organizationId, stockEntryId])
}

model WorkOrder {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @db.Uuid
  customerId             String          @db.Uuid
  vehicleId              String          @db.Uuid
  quoteId                String?         @db.Uuid
  number                 Int
  status                 WorkOrderStatus @default(OPEN)
  reportedProblem        String?
  diagnosis              String?
  mileage                Int?
  expectedCompletionDate DateTime?       @db.Date
  notes                  String?
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer         Customer                   @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  vehicle          Vehicle                    @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)
  quote            Quote?                     @relation(fields: [organizationId, quoteId], references: [organizationId, id], onDelete: Restrict)
  items            WorkOrderItem[]
  payments         Payment[]
  stockMovements   StockMovement[]
  stockAllocations WorkOrderStockAllocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, quoteId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
}

model WorkOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workOrderId    String   @db.Uuid
  type           ItemType
  serviceId      String?  @db.Uuid
  productId      String?  @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(10, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder        WorkOrder                  @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Cascade)
  service          Service?                   @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)
  product          Product?                   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  stockAllocations WorkOrderStockAllocation[]

  @@unique([organizationId, id])
  @@index([organizationId, workOrderId])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  workOrderId    String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(CONFIRMED)
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workOrderId, status])
  @@index([organizationId, paidAt])
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(12, 2)
  dueDate        DateTime        @db.Date
  status         ExpenseStatus   @default(OPEN)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payments     ExpensePayment[]
  purchase     Purchase?

  @@unique([organizationId, id])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, category])
}

model ExpensePayment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  expenseId      String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(CONFIRMED)
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expense      Expense      @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, expenseId, status])
  @@index([organizationId, paidAt])
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  supplierId     String         @db.Uuid
  expenseId      String?        @unique @db.Uuid
  status         PurchaseStatus @default(DRAFT)
  purchaseDate   DateTime       @db.Date
  dueDate        DateTime       @db.Date
  documentNumber String?
  notes          String?
  confirmedAt    DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier       @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  expense      Expense?       @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict)
  items        PurchaseItem[]
  stockEntries StockEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, expenseId])
  @@index([organizationId, status, purchaseDate])
  @@index([organizationId, supplierId])
}

model PurchaseItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  purchaseId     String   @db.Uuid
  productId      String   @db.Uuid
  productName    String
  sku            String
  quantity       Int
  unitCost       Decimal  @db.Decimal(12, 2)
  warrantyDays   Int      @default(0)
  batchNumber    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase     Purchase     @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  stockEntry   StockEntry?

  @@unique([organizationId, id])
  @@index([organizationId, purchaseId])
}

model StockEntry {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  purchaseId       String           @db.Uuid
  purchaseItemId   String           @unique @db.Uuid
  productId        String           @db.Uuid
  supplierId       String           @db.Uuid
  quantity         Int
  consumedQuantity Int              @default(0)
  unitCost         Decimal          @db.Decimal(12, 2)
  purchaseDate     DateTime         @db.Date
  batchNumber      String?
  documentNumber   String?
  warrantyDays     Int              @default(0)
  status           StockEntryStatus @default(AVAILABLE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchase                   Purchase                    @relation(fields: [organizationId, purchaseId], references: [organizationId, id], onDelete: Restrict)
  purchaseItem               PurchaseItem                @relation(fields: [organizationId, purchaseItemId], references: [organizationId, id], onDelete: Restrict)
  product                    Product                     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  supplier                   Supplier                    @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  workOrderStockAllocations  WorkOrderStockAllocation[]
  directSaleStockAllocations DirectSaleStockAllocation[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseItemId])
  @@index([organizationId, productId, status, createdAt])
}

enum StockMovementType {
  CONSUMPTION
  ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum StockEntryStatus {
  AVAILABLE
  CANCELLED
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  productId      String            @db.Uuid
  workOrderId    String?           @db.Uuid
  directSaleId   String?           @db.Uuid
  type           StockMovementType
  quantityChange Int
  note           String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  workOrder    WorkOrder?   @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  directSale   DirectSale?  @relation(fields: [organizationId, directSaleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, productId, workOrderId, type])
  @@index([organizationId, productId, createdAt])
}

model DirectSale {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  customerId     String?          @db.Uuid
  number         Int
  status         DirectSaleStatus @default(DRAFT)
  confirmedAt    DateTime?        @db.Timestamptz(3)
  cancelledAt    DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer         Customer?                   @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  items            DirectSaleItem[]
  payments         SalePayment[]
  stockAllocations DirectSaleStockAllocation[]
  stockMovements   StockMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
}

model DirectSaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  directSaleId   String   @db.Uuid
  productId      String   @db.Uuid
  productName    String
  sku            String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  directSale       DirectSale                  @relation(fields: [organizationId, directSaleId], references: [organizationId, id], onDelete: Cascade)
  product          Product                     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  stockAllocations DirectSaleStockAllocation[]

  @@unique([organizationId, id])
  @@index([organizationId, directSaleId])
}

model DirectSaleStockAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  directSaleId     String   @db.Uuid
  directSaleItemId String   @db.Uuid
  stockEntryId     String?  @db.Uuid
  quantity         Int
  unitCost         Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  directSale     DirectSale     @relation(fields: [organizationId, directSaleId], references: [organizationId, id], onDelete: Restrict)
  directSaleItem DirectSaleItem @relation(fields: [organizationId, directSaleItemId], references: [organizationId, id], onDelete: Restrict)
  stockEntry     StockEntry?    @relation(fields: [organizationId, stockEntryId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, directSaleId])
  @@index([organizationId, directSaleItemId])
  @@index([organizationId, stockEntryId])
}

model SalePayment {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid
  directSaleId       String        @db.Uuid
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus @default(CONFIRMED)
  paidAt             DateTime?     @db.Timestamptz(3)
  installmentDueDate DateTime?     @db.Date
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  directSale   DirectSale   @relation(fields: [organizationId, directSaleId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, directSaleId, status])
  @@index([organizationId, paidAt])
}
