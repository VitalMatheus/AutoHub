NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://autohub:change-me@localhost:5432/autohub?schema=public
POSTGRES_DB=autohub
POSTGRES_USER=autohub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Used only by npm run bootstrap:super-admin; never commit real credentials.
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
EMAIL_DELIVERY_MODE=capture
RESEND_API_KEY=
RESEND_FROM=Vekar <noreply@example.com>
PUBLIC_APP_URL=http://localhost:5173
TURNSTILE_REQUIRED=false
ASAAS_MODE=capture
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=local-asaas-webhook-secret
TURNSTILE_SECRET_KEY=
TRIAL_ELIGIBILITY_PEPPER=replace-with-at-least-16-random-characters
